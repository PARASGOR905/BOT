decrypter: 'packager'
tag: 'RGP'
tag_sd: ''

arguments: {}

aria2c:
  file_allocation: 'none'
  max_connection_per_server: '16'
  split: '16'
  max_concurrent_downloads: '16'
  timeout: '15'
  max_tries: '5'
  retry_wait: '1'
  

cdm:
  default: 'xiaomi_mi_a1_15.0.0_60ceee88_8159_l3'
  DisneyPlus: 'changhong_ai_pont_15.0.0_13182_l1'
  Netflix: 'Decrypt Labs - KeyXtractor API [playready]'
