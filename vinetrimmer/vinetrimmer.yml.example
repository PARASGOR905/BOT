  Zee5: 'hisense_smarttv_he55a7000euwts_sl3000'
  Max: 'changhong_ai_pont_15.0.0_13182_l1'
  AppleTV: 'arcelik_smart_tv_optomax_nt_sl3000'
  NowTVUK: 'hisense_smarttv_4k_ffm_65u67kua_sl3000'
  Waves: 'xiaomi_mi_a1_15.0.0_60ceee88_8159_l3'
  Hulu: 'arcelik_smart_tv_optomax_nt_sl3000'
  Watcho: 'xiaomi_mi_a1_15.0.0_60ceee88_8159_l3'
  Vivamax: ''
  AAONXT: 'xiaomi_mi_a1_15.0.0_60ceee88_8159_l3'
